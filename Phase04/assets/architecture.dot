digraph G {
 graph [fontname="DejaVu Sans", bgcolor="transparent", nodesep=0.38, ranksep=0.68, splines=ortho, pad=0.30];
 node [shape=box, style="rounded,filled", penwidth=1.3, fontname="DejaVu Sans", fontsize=12, margin="0.23,0.16"];
 edge [color="#7893b2", penwidth=2, arrowsize=0.65];
 developer [label="Developer\nGitHub repository",fillcolor="#e8f2ff",color="#5d9ddb",fontcolor="#14375a"];
 ci [label="GitHub Actions CI\nTests • Trivy gates",fillcolor="#e8f2ff",color="#5d9ddb",fontcolor="#14375a"];
 docker [label="Docker Build\nPrebuilt Azure Vote image",fillcolor="#e8f2ff",color="#5d9ddb",fontcolor="#14375a"];
 sbom [label="Vulnerability report\nCycloneDX SBOM",fillcolor="#fff3df",color="#d7a04a",fontcolor="#674717"];
 ghcr [label="GHCR Registry\nImage tagged by Git SHA",fillcolor="#e4f5ef",color="#4a9b79",fontcolor="#174b39"];
 manual [label="Manual release\nEnvironment approval",fillcolor="#fff3df",color="#d7a04a",fontcolor="#674717"];
 oidc [label="Entra OIDC identity\nScoped Azure RBAC",fillcolor="#e9e9ff",color="#8f86d6",fontcolor="#3c3675"];
 azure [label="Existing Azure Container App\nFrontend container only",fillcolor="#e4f5ef",color="#4a9b79",fontcolor="#174b39"];
 test [label="HTTPS verification\nEvidence + Terraform reconcile",fillcolor="#e8f2ff",color="#5d9ddb",fontcolor="#14375a"];
 developer -> ci -> docker -> ghcr -> manual -> azure -> test;
 docker -> sbom [constraint=false];
 manual -> oidc [constraint=false,style=dashed];
 oidc -> azure [constraint=false,style=dashed];
 {rank=same; docker; sbom;}
 {rank=same; manual; oidc;}
}
