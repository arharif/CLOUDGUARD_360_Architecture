
digraph G { graph [bgcolor="transparent",rankdir=TB,pad=0.25, nodesep=0.36,ranksep=0.48, fontname="DejaVu Sans",label="CLOUDGUARD 360  |  PHASE 02 — IDENTITY & RBAC",labelloc=t,fontsize=24,fontcolor="#11365c"]; node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,margin="0.2,0.15",color="#8fb4d2",fillcolor="#eaf3fb",fontcolor="#143c63"]; edge[color="#4582ae",penwidth=1.7,arrowsize=0.8]; engineer [label="Cloud Engineer / Test User",fillcolor="#eef6ff"]; entra [label="Microsoft Entra ID\nAuthenticate identity",fillcolor="#cfe9ff"]; groups [label="Security Groups\nCloud / Developers / Auditors / Operations"]; rbac [label="Azure RBAC\nRole + Scope",fillcolor="#daf1e3",color="#63a387"]; sub [label="Existing Azure subscription",fillcolor="#f2f5f8"]; rg1[label="rg-cg360-network\nReader / Monitoring Reader"];rg2[label="rg-cg360-app\nReader / Monitoring Reader"]; hub [label="Hub VNet (existing)\nDo not recreate",fillcolor="#f4f8fb"];spoke[label="App Spoke VNet (existing)\nDo not recreate",fillcolor="#f4f8fb"]; tf[label="Separate Terraform Phase 02 root\nCreates groups + assignments only",fillcolor="#fff1d9",color="#d8a960"]; engineer->entra; entra->groups;groups->rbac;rbac->sub;sub->rg1;sub->rg2;rg1->hub;rg2->spoke;tf->groups [style=dashed];tf->rbac [style=dashed]; }
